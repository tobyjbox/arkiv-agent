{
  "name": "arkiv-agent",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": { "node": ">=22.10" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "dev": "pnpm --filter arkiv-agent dev",
    "spike:read": "pnpm --filter @arkiv-agent/indexer spike:read",
    "spike:history": "pnpm --filter @arkiv-agent/indexer spike:history",
    "spike:fees": "pnpm --filter @arkiv-agent/indexer spike:fees"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
