# Arkiv Tiramisu testnet (read-only by default)
ARKIV_RPC_URL=https://rpc.tiramisu.db-chain.testnet.arkiv.network
# Optional: Arkiv Hub access key (hub.arkiv.network/api-keys, Tiramisu). Raises RPC limits.
ARKIV_API_KEY=

# Local index (SQLite via Prisma). Relative paths resolve from the repo root.
DATABASE_URL=file:./data/arkiv-agent.db
# Optional: indexer decode rate in requests/s (default 8 anonymous, 25 with ARKIV_API_KEY).
ARKIV_RPS=

# Optional: Claude for dataset descriptions and Ask Arkiv. Without it, Ask uses catalogue rules.
ANTHROPIC_API_KEY=

# ArkivAgent listens on 127.0.0.1 only and answers to localhost names. To open it to your network, set
# both in the shell (not here): ARKIV_AGENT_HOST=0.0.0.0 ARKIV_AGENT_ALLOWED_HOSTS=my-laptop.local pnpm start

# Optional: faucet-funded TESTNET key, only for fee experiments. Never a mainnet key.
ARKIV_TEST_PRIVATE_KEY=
